{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler", // Ideal para Playwright moderno
    "baseUrl": ".", // Define la raíz para que los paths sean consistentes

    /* Alias de rutas */
    "paths": {
      "@pages/*": ["pages/*"],
      "@fixtures/*": ["fixtures/*"],
      "@components/*": ["components/*"]
    },

    /* Estrictez y Calidad (Nivel Senior) */
    "strict": true,
    "noUnusedLocals": true, // Te avisa si dejas variables sin usar
    "noUnusedParameters": true, // Limpieza en tus métodos de POM
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, // Evita errores entre Windows/Linux

    /* Playwright no necesita emitir JS, solo chequear tipos */
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true // Útil si guardas datos de prueba en archivos .json
  },
  "include": [
    "tests/**/*",
    "pages/**/*",
    "fixtures/**/*",
    "playwright.config.ts" // Importante incluir la config global
  ],
  "exclude": ["node_modules"]
}
